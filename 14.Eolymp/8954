import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        // example below, replace it with your solution
        Scanner in = new Scanner(System.in);
        int n=in.nextInt();
        int[] arr=new int [n];
        for (int i=0; i<n; i++){
            arr[i]=in.nextInt();
        }
        for (int i=n-1; i>=0; i--){
            System.out.print(arr[i]);
            if(i>0){
                System.out.print(" ");
            }
        }


    }
}
